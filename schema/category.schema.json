{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://samotech.github.io/skills-tree/schema/category.schema.json",
  "title": "Category",
  "type": "object",
  "required": ["id", "name", "layer", "directory"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{2}-[a-z][a-z0-9-]*$" },
    "name": { "type": "string" },
    "layer": { "type": "string", "enum": ["perception", "reasoning", "execution", "systems"] },
    "directory": { "type": "string" },
    "description": { "type": "string" },
    "skill_count": { "type": "integer", "minimum": 0 }
  }
}
