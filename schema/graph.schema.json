{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://samotech.github.io/skills-tree/schema/graph.schema.json",
  "title": "SkillsGraph",
  "description": "Root schema for data/SKILLS_GRAPH.json. This file is GENERATED — do not edit manually.",
  "type": "object",
  "required": ["meta", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["generated_at", "generator", "schema_version", "node_count", "edge_count"],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "generator": { "type": "string", "description": "Script that produced this file (e.g. tools/build_graph.py)." },
        "schema_version": { "type": "string" },
        "node_count": { "type": "integer", "minimum": 0 },
        "edge_count": { "type": "integer", "minimum": 0 },
        "initiative": { "type": "string", "description": "INITIATIVE-001 V3" }
      }
    },
    "nodes": {
      "type": "array",
      "description": "All skill nodes. Each item conforms to skill.schema.json.",
      "items": { "$ref": "skill.schema.json" }
    },
    "edges": {
      "type": "array",
      "description": "All directed edges between skills. Each item conforms to edge.schema.json.",
      "items": { "$ref": "edge.schema.json" }
    }
  }
}
