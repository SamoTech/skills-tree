{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://samotech.github.io/skills-tree/schema/skill.schema.json",
  "title": "Skill",
  "description": "A single skill node in the AI Engineering Skills Tree",
  "type": "object",
  "required": ["id", "title", "category", "level", "stability"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$",
      "description": "Unique slug derived from category path and filename. e.g. 02-reasoning/commonsense"
    },
    "title": { "type": "string", "minLength": 2 },
    "category": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z][a-z0-9-]*$"
    },
    "layer": {
      "type": "string",
      "enum": ["perception", "reasoning", "execution", "systems"]
    },
    "level": {
      "type": "string",
      "enum": ["basic", "intermediate", "advanced", "expert"]
    },
    "stability": {
      "type": "string",
      "enum": ["stable", "experimental", "deprecated", "draft"]
    },
    "version": { "type": "string" },
    "added": { "type": "string" },
    "last_updated": { "type": "string" },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "related_skills": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "source_file": { "type": "string" }
  }
}
