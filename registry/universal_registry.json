    "benchmarks": [
      {
        "id": "benchmark/retrieval-cli-v1",
        "version": "1.0",
        "name": "Deterministic CLI Retrieval Quality",
        "task": "Measure whether the canonical deterministic CLI search retrieves the repository skill intended by a bounded set of provenance-backed capability queries.",
        "inputs": [
          "Canonical generated search projection data/search-index.json",
          "Versioned benchmark query dataset benchmarks/retrieval/cli-search-v1.json",
          "Canonical cli.search_engine.search_documents implementation"
        ],
        "expected_behavior": [
          "Rank the expected canonical skill within the top 5 for each benchmark query when the query is designed from that skill's canonical title/description.",
          "Produce deterministic results from the same search projection and benchmark dataset.",
          "Record repository commit, search-index digest, dataset digest, per-query ranks, and aggregate retrieval metrics."
        ],
        "evaluation_criteria": [
          "Recall@5 >= 0.90",
          "MRR >= 0.80",
          "Deterministic replay produces identical ranked IDs for identical inputs."
        ],
        "test_data": [
          "benchmarks/retrieval/cli-search-v1.json",
          "data/search-index.json"
        ],
        "methodology": "Offline deterministic replay against the canonical generated search projection using cli.search_engine.search_documents. Queries are manually authored from canonical skill titles/descriptions; expected IDs are the exact canonical skill paths. This benchmark is an evidence instrument, not a popularity or semantic-understanding claim. The workflow records results as an artifact and does not alter ranking or block merges.",
        "historical_results": [],
        "provenance": {
          "source_type": "repository",
          "source": "Canonical skill definitions and deterministic CLI search contract",
          "verified_at": "2026-10-05T11:10:00Z",
          "confidence": 1,
          "methodology": "Expected skill IDs are derived directly from canonical skill paths; query text is authored from the corresponding canonical skill title/description and retained as versioned benchmark data."
        }
      },
      {
        "id": "benchmark/skill-selection-v1",
        "version": "1.0",
        "name": "Deterministic Capability Skill Selection",
        "task": "Measure whether explicit capability requirements select the correct canonical skill, route prerequisites, and fail closed when no justified recovery candidate exists.",
        "inputs": [
          "Canonical registry registry/universal_registry.json",
          "Versioned dataset benchmarks/selection/capability-selection-v1.json",
          "Canonical graph data/SKILLS_GRAPH.json",
          "registry.skill_selection.SkillSelectionEngine"
        ],
        "expected_behavior": [
          "Select a registered candidate covering the required capability",
          "Reject lower-fit or unrelated registered candidates with explicit reasons",
          "Fail closed when a candidate is not registered",
          "Return BLOCKED when no sufficient or recovery candidate exists",
          "Produce deterministic output for identical inputs"
        ],
        "evaluation_criteria": [
          "100% benchmark case accuracy",
          "Deterministic replay produces identical structured output"
        ],
        "test_data": [
          "benchmarks/selection/capability-selection-v1.json",
          "registry/universal_registry.json",
          "data/SKILLS_GRAPH.json"
        ],
        "methodology": "Offline deterministic replay against the canonical registry and eligibility runtime. The current version covers registered capability matches, explicit fail-closed handling, one prerequisite-bearing registered skill (agentic-rag), and terminal recovery behavior. Prerequisite routing is evidenced only for the registered Agentic RAG -> RAG dependency represented in the canonical graph. This is bounded behavioral evidence, not a claim of general semantic understanding or autonomous-agent success.",
        "historical_results": [],
        "provenance": {
          "source_type": "repository",
          "source": "Capability-Based Skill Selection contract and canonical registry/graph",
          "verified_at": "2026-10-05T13:00:00Z",
          "confidence": 1,
          "methodology": "Expected outputs are explicitly versioned in the benchmark dataset and evaluated against the canonical runtime."
        }
      },
      {
        "id": "benchmark/skill-activation-v1",
        "version": "1.0",
        "name": "Trace-Based Skill Activation and Invocation Evidence",
        "task": "Measure observed natural-language skill activation, false activation, repeated-run variance, collision behavior, and explicit invocation evidence from agent runtime traces.",
        "inputs": [
          "Versioned dataset benchmarks/activation/skill-activation-v1.json",
          "Externally captured agent trace observations containing skill_selection and skill_execution events"
        ],
        "expected_behavior": [
          "Measure whether the expected skill was selected for each prompt case",
          "Measure whether forbidden skills were selected",
          "Measure repeated-run activation variance",
          "Require explicit skill execution events for invocation evidence",
          "Never infer activation from prompt text or deterministic fixtures"
        ],
        "evaluation_criteria": [
          "Expected activation rate is computed only from observed runs",
          "False activation rate is computed only from observed forbidden selections",
          "Invocation evidence rate requires explicit skill_execution events",
          "NO_OBSERVATIONS is never reported as PASS"
        ],
        "test_data": [
          "benchmarks/activation/skill-activation-v1.json"
        ],
        "methodology": "Trace-based offline evaluation. The benchmark definition is deterministic, but empirical activation evidence must come from an external agent runtime emitting structured skill selection and execution events. The runner measures observed rates and variance without simulating or inferring model routing.",
