{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/skills-tree/blob/main/benchmarks/self-evaluation/cap011-dataset.schema.json",
  "title": "CAP-011 Independent Ground-Truth Assessment Dataset",
  "description": "Schema for an empirically evaluated CAP-011 dataset. Synthetic fixtures and unadjudicated labels do not satisfy this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "dataset_status",
    "provenance",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "const": "cap011-self-evaluation-v1"
    },
    "dataset_status": {
      "const": "ground_truth_reviewed"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "created_at",
        "label_protocol",
        "source_references",
        "ground_truth_independent_of_system_under_test"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "human_reviewed",
            "official_documentation",
            "controlled_experiment"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "label_protocol": {
          "type": "string",
          "minLength": 20
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ground_truth_independent_of_system_under_test": {
          "const": true
        },
        "double_adjudication_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 100,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "task_input",
          "evidence_context",
          "expected_outcome",
          "adjudication"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^CAP011-[A-Z0-9][A-Z0-9_-]+$"
          },
          "task_input": {
            "type": "string",
            "minLength": 1
          },
          "evidence_context": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_outcome": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "adjudication": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer_id",
              "reviewed_at",
              "evidence_references",
              "rationale"
            ],
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    }
  }
}
