{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/skills-tree/blob/main/benchmarks/retrieval/cap007-dataset.schema.json",
  "title": "CAP-007 Human-Labeled Retrieval Dataset",
  "description": "Schema for an empirically evaluated CAP-007 retrieval dataset. Synthetic fixtures and machine-generated labels do not satisfy this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "dataset_status",
    "provenance",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "const": "cap007-retrieval-human-v1"
    },
    "dataset_status": {
      "const": "human_labeled"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "created_at",
        "label_protocol",
        "source_references",
        "labels_independent_of_retrieval_engine"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "support_tickets",
            "user_questions",
            "forum_or_public_qa",
            "controlled_experiment"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "label_protocol": {
          "type": "string",
          "minLength": 20
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "labels_independent_of_retrieval_engine": {
          "const": true
        },
        "inter_labeler_agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 100,
      "maxItems": 1000,
      "allOf": [
        {
          "contains": {
            "properties": {
              "query_type": {
                "const": "exact_match"
              }
            },
            "required": [
              "query_type"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "query_type": {
                "const": "paraphrase"
              }
            },
            "required": [
              "query_type"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "query_type": {
                "const": "multi_hop"
              }
            },
            "required": [
              "query_type"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "query_type": {
                "const": "no_relevant_document"
              }
            },
            "required": [
              "query_type"
            ]
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "query",
          "query_type",
          "expected_skill_ids",
          "labeling"
        ],
        "if": {
          "properties": {
            "query_type": {
              "const": "no_relevant_document"
            }
          },
          "required": [
            "query_type"
          ]
        },
        "then": {
          "properties": {
            "expected_skill_ids": {
              "maxItems": 0
            }
          }
        },
        "else": {
          "properties": {
            "expected_skill_ids": {
              "minItems": 1
            }
          }
        },
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^CAP007-[A-Z0-9][A-Z0-9_-]+$"
          },
          "query": {
            "type": "string",
            "minLength": 8
          },
          "query_type": {
            "enum": [
              "exact_match",
              "paraphrase",
              "multi_hop",
              "no_relevant_document"
            ]
          },
          "expected_skill_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{2}-[a-z0-9-]+/[a-z0-9_-]+$"
            }
          },
          "labeling": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "labeler_id",
              "labeled_at",
              "evidence_references",
              "rationale"
            ],
            "properties": {
              "labeler_id": {
                "type": "string",
                "minLength": 1
              },
              "labeled_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    }
  }
}
