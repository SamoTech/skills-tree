{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SamoTech/skills-tree/raw/main/meta/skill-schema.json",
  "title": "AI Agent Skill",
  "description": "Schema for a reusable AI Agent Skill: procedural guidance, instructions, and task-specific knowledge used by an agent. A skill is distinct from the capability being provided, the model performing inference, and the tools/runtime exposing actions.",
  "type": "object",
  "required": [
    "title",
    "category",
    "level",
    "stability",
    "added",
    "description"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Human-readable skill name, e.g. 'Chain-of-Thought Reasoning'"
    },
    "category": {
      "type": "string",
      "description": "Category slug, e.g. '02-reasoning'",
      "enum": [
        "01-perception",
        "02-reasoning",
        "03-memory",
        "04-action-execution",
        "05-code",
        "06-communication",
        "07-tool-use",
        "08-multimodal",
        "09-agentic-patterns",
        "10-computer-use",
        "11-web",
        "12-data",
        "13-creative",
        "14-security",
        "15-orchestration",
        "16-domain-specific",
        "17-infrastructure"
      ]
    },
    "level": {
      "type": "string",
      "description": "Skill difficulty level",
      "enum": [
        "basic",
        "intermediate",
        "advanced",
        "experimental"
      ]
    },
    "stability": {
      "type": "string",
      "description": "How stable/mature this skill is",
      "enum": [
        "stable",
        "evolving",
        "experimental",
        "deprecated"
      ]
    },
    "version": {
      "type": "string",
      "description": "Skill document version, e.g. 'v1', 'v2', 'v3'",
      "pattern": "^v[0-9]+$"
    },
    "added": {
      "type": "string",
      "description": "Month when the skill was first added, format YYYY-MM",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "last_updated": {
      "type": "string",
      "description": "Month of last update, format YYYY-MM",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "updated": {
      "type": "string",
      "description": "Canonical month of last update used by current skill files, format YYYY-MM",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "description": {
      "type": "string",
      "description": "1-3 sentence description of the reusable procedure or task-specific knowledge this skill provides to guide an agent in performing a task"
    },
    "tags": {
      "type": "array",
      "description": "Short searchable tags associated with the skill",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "array",
      "description": "Related skill identifiers or file slugs",
      "items": {
        "type": "string"
      }
    },
    "related_skills": {
      "type": "array",
      "description": "List of related skill file paths relative to the skills/ root",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "description": "Skill identifiers that should be learned first",
      "items": {
        "type": "string"
      }
    },
    "frameworks": {
      "type": "array",
      "description": "Frameworks or models associated with this skill; this metadata does not make the framework or model the skill itself.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "implementation": {
            "type": "string"
          },
          "since": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Declared external package dependencies used by executable skill examples.",
      "items": {
        "type": "object",
        "required": [
          "package"
        ],
        "properties": {
          "package": {
            "type": "string"
          },
          "min_version": {
            "type": "string"
          },
          "tested_version": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "machine-inferred",
              "verified"
            ]
          },
          "import_name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "deps": {
      "type": "array",
      "description": "Legacy dependency field retained only for migration compatibility.",
      "items": {
        "type": "object",
        "required": [
          "package"
        ],
        "properties": {
          "package": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "import_name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
