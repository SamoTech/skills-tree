{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/skills-tree/blob/main/meta/universal-registry-data.schema.json",
  "title": "Skills Tree Universal Registry Data",
  "description": "Normative machine-readable schema for registry/universal_registry.json.",
  "type": "object",
  "required": [
    "registry_version",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "1.0"
    },
    "entities": {
      "type": "object",
      "required": [
        "goals",
        "capabilities",
        "skills",
        "implementations",
        "tools",
        "models",
        "platforms",
        "frameworks",
        "adapters",
        "evidence",
        "benchmarks",
        "architectures",
        "protocols",
        "runtimes",
        "compatibilities"
      ],
      "additionalProperties": false,
      "properties": {
        "goals": {
          "$ref": "#/$defs/entityList"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilityList"
        },
        "skills": {
          "$ref": "#/$defs/skillList"
        },
        "implementations": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/SamoTech/skills-tree/blob/main/meta/implementation-contract.schema.json#/$defs/implementation"
          }
        },
        "tools": {
          "$ref": "#/$defs/entityList"
        },
        "models": {
          "$ref": "#/$defs/entityList"
        },
        "platforms": {
          "$ref": "#/$defs/entityList"
        },
        "frameworks": {
          "$ref": "#/$defs/entityList"
        },
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/SamoTech/skills-tree/blob/main/meta/adapter-contract.schema.json#/$defs/adapter"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/SamoTech/skills-tree/blob/main/meta/benchmark-contract.schema.json#/$defs/benchmark"
          }
        },
        "architectures": {
          "$ref": "#/$defs/entityList"
        },
        "protocols": {
          "$ref": "#/$defs/entityList"
        },
        "runtimes": {
          "$ref": "#/$defs/entityList"
        },
        "compatibilities": {
          "$ref": "#/$defs/compatibilityList"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$",
      "minLength": 2
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_type"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "repository",
            "official_documentation",
            "implementation",
            "benchmark",
            "production",
            "community",
            "experimental"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "methodology": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "version",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": true
    },
    "entityList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "capability": {
      "allOf": [
        {
          "$ref": "#/$defs/entity"
        },
        {
          "type": "object",
          "required": [
            "name",
            "skills",
            "implementations",
            "adapters"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "skills": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "implementations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "adapters": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ]
    },
    "capabilityList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "skill": {
      "allOf": [
        {
          "$ref": "#/$defs/entity"
        },
        {
          "type": "object",
          "required": [
            "canonical",
            "capabilities",
            "implementations"
          ],
          "properties": {
            "canonical": {
              "type": "boolean",
              "const": true
            },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "implementations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ]
    },
    "skillList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/entity"
        },
        {
          "type": "object",
          "required": [
            "name",
            "type",
            "source",
            "supports"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "supports": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ]
    },
    "evidenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "id",
        "version",
        "name",
        "subject",
        "target",
        "status",
        "evidence",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "platform",
                "framework",
                "model",
                "protocol",
                "runtime"
              ]
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": [
            "compatible",
            "conditional",
            "incompatible",
            "unknown",
            "deprecated"
          ]
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "compatibilityList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compatibility"
      }
    }
  }
}
