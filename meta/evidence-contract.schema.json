{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/skills-tree/blob/main/meta/evidence-contract.schema.json",
  "title": "Skills Tree Universal Evidence Contract",
  "description": "Machine-readable contract for provenance-backed evidence that explicitly supports one or more registry claims.",
  "type": "object",
  "required": ["contract_version", "evidence"],
  "properties": {
    "contract_version": { "type": "string", "const": "1.0" },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "minLength": 2 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "provenance": {
      "type": "object",
      "required": ["source_type", "source"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["repository", "official_documentation", "implementation", "benchmark", "production", "community", "experimental"]
        },
        "source": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "methodology": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "version", "name", "type", "source", "supports", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["official_documentation", "repository", "implementation", "benchmark", "production", "community", "experimental"]
        },
        "source": { "type": "string", "minLength": 1 },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    }
  }
}