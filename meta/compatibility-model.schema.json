{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/skills-tree/blob/main/meta/compatibility-model.schema.json",
  "title": "Skills Tree Compatibility Model",
  "description": "Canonical contract for evidence-backed compatibility facts between registry entities.",
  "type": "object",
  "required": [
    "contract_version",
    "compatibility"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "id",
        "version",
        "name",
        "subject",
        "target",
        "status",
        "evidence",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$",
          "minLength": 2
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "target": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "platform",
                "framework",
                "model",
                "protocol",
                "runtime"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/-]*$"
            }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "compatible",
            "conditional",
            "incompatible",
            "unknown",
            "deprecated"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]*$"
          }
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_type",
            "source"
          ],
          "properties": {
            "source_type": {
              "enum": [
                "repository",
                "official_documentation",
                "implementation",
                "benchmark",
                "production",
                "community",
                "experimental"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "methodology": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
