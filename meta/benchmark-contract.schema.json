{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/skills-tree/blob/main/meta/benchmark-contract.schema.json",
  "title": "Skills Tree Universal Benchmark Contract",
  "description": "Machine-readable contract for reproducible behavioral evaluation definitions in the universal registry.",
  "type": "object",
  "required": ["contract_version", "benchmark"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "type": "string", "const": "1.0" },
    "benchmark": { "$ref": "#/$defs/benchmark" }
  },
  "$defs": {
    "benchmark": {
      "type": "object",
      "required": ["id","version","name","task","inputs","expected_behavior","evaluation_criteria","test_data","methodology","historical_results","provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "minLength": 2 },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "expected_behavior": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evaluation_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "test_data": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "methodology": { "type": "string", "minLength": 1 },
        "historical_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recorded_at", "metric", "value"],
            "additionalProperties": false,
            "properties": {
              "recorded_at": { "type": "string", "format": "date-time" },
              "metric": { "type": "string", "minLength": 1 },
              "value": {},
              "notes": { "type": "string" }
            }
          }
        },
        "subjects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "minLength": 2 }
        },
        "provenance": {
          "type": "object",
          "required": ["source_type"],
          "additionalProperties": false,
          "properties": {
            "source_type": { "type": "string", "enum": ["repository","official_documentation","implementation","benchmark","production","community","experimental"] },
            "source": { "type": "string", "minLength": 1 },
            "verified_at": { "type": "string", "format": "date-time" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "methodology": { "type": "string" }
          }
        }
      }
    }
  }
}
