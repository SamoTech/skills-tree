{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/skills-tree/blob/main/meta/universal-registry.schema.json",
  "title": "Skills Tree Universal Agent Registry",
  "description": "Canonical machine-readable contract for platform-agnostic agent capability knowledge.",
  "type": "object",
  "required": [
    "schema_version",
    "entity_types",
    "relationship_types"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "entity_types": {
      "type": "object",
      "required": [
        "goal",
        "capability",
        "skill",
        "implementation",
        "tool",
        "model",
        "platform",
        "framework",
        "protocol",
        "runtime",
        "adapter",
        "evidence",
        "benchmark",
        "architecture",
        "compatibility"
      ],
      "additionalProperties": false,
      "properties": {
        "goal": { "$ref": "#/$defs/entityDefinition" },
        "capability": { "$ref": "#/$defs/entityDefinition" },
        "skill": { "$ref": "#/$defs/skillDefinition" },
        "implementation": { "$ref": "implementation-contract.schema.json#/$defs/implementation" },
        "tool": { "$ref": "#/$defs/entityDefinition" },
        "model": { "$ref": "#/$defs/entityDefinition" },
        "platform": { "$ref": "#/$defs/entityDefinition" },
        "framework": { "$ref": "#/$defs/entityDefinition" },
        "adapter": { "$ref": "#/$defs/entityDefinition" },
        "evidence": { "$ref": "#/$defs/entityDefinition" },
        "benchmark": { "$ref": "#/$defs/entityDefinition" },
        "architecture": { "$ref": "#/$defs/entityDefinition" },
        "compatibility": { "$ref": "#/$defs/compatibilityDefinition" },
        "protocol": { "$ref": "#/$defs/entityDefinition" },
        "runtime": { "$ref": "#/$defs/entityDefinition" }
      }
    },
    "relationship_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "requires_capability",
          "enables_skill",
          "realized_by",
          "implemented_with",
          "exposed_by",
          "adapted_to",
          "supported_by_model",
          "alternative_to",
          "enhances",
          "unlocks",
          "supported_by_evidence",
          "validated_by_benchmark",
          "constrained_by",
          "composes_with",
          "depends_on",
          "exposed_through"
        ]
      }
    }
  },
  "$defs": {
    "entityDefinition": {
      "type": "object",
      "required": ["id", "version", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": true
    },
    "compatibilityDefinition": {
      "allOf": [
        { "$ref": "#/$defs/entityDefinition" },
        {
          "type": "object",
          "required": ["id", "version", "name", "provenance", "subject", "target", "status", "evidence"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "version": { "$ref": "#/$defs/version" },
            "name": { "type": "string", "minLength": 1 },
            "provenance": { "$ref": "#/$defs/provenance" },
            "subject": { "$ref": "#/$defs/id" },
            "target": {
              "type": "object",
              "required": ["type", "id"],
              "properties": {
                "type": { "type": "string", "enum": ["platform", "framework", "model", "protocol", "runtime"] },
                "id": { "$ref": "#/$defs/id" }
              },
              "additionalProperties": false
            },
            "status": { "type": "string", "enum": ["compatible", "conditional", "incompatible", "unknown", "deprecated"] },
            "evidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "constraints": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "skillDefinition": {
      "allOf": [
        { "$ref": "#/$defs/entityDefinition" },
        {
          "type": "object",
          "required": ["canonical", "capabilities", "implementations"],
          "properties": {
            "canonical": {
              "type": "boolean",
              "const": true,
              "description": "Canonical skills are platform-agnostic definitions, never platform-specific duplicates."
            },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "implementations": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$",
      "minLength": 2
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "type": "object",
      "required": ["source_type", "source"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "repository",
            "official_documentation",
            "implementation",
            "benchmark",
            "production",
            "community",
            "experimental"
          ]
        },
        "source": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "methodology": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
