{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/SamoTech/skills-tree/blob/main/meta/universal-graph.schema.json",
  "title":"Skills Tree Typed Universal Graph Contract",
  "type":"object","required":["graph_version","edges"],
  "properties":{
    "graph_version":{"type":"string","const":"1.0"},
    "edges":{"type":"array","uniqueItems":true,"items":{"type":"object","required":["source","source_type","target","target_type","relationship_type","provenance"],"properties":{
      "source":{"type":"string","minLength":2},"source_type":{"type":"string","enum":["goal","capability","skill","implementation","tool","model","platform","framework","protocol","runtime","adapter","evidence","benchmark","architecture","compatibility"]},
      "target":{"type":"string","minLength":2},"target_type":{"type":"string","enum":["goal","capability","skill","implementation","tool","model","platform","framework","protocol","runtime","adapter","evidence","benchmark","architecture","compatibility"]},
      "relationship_type":{"type":"string","enum":["requires_capability","enables_skill","realized_by","implemented_with","exposed_by","adapted_to","supported_by_model","alternative_to","enhances","unlocks","supported_by_evidence","validated_by_benchmark","constrained_by","composes_with","depends_on","exposed_through"]},
      "provenance":{"type":"object","required":["source_type","source"],"properties":{"source_type":{"type":"string","enum":["repository","official_documentation","implementation","benchmark","production","community","experimental"]},"source":{"type":"string","minLength":1}},"additionalProperties":false}
    },"additionalProperties":false}}
  },"additionalProperties":false
}
